{
  "name": "founders-marketplace-templates",
  "private": true,
  "description": "Shared install and gallery tooling for the marketplace UI template library. Every template under templates/<slug> resolves its packages from here, so one install builds all of them; each template also still installs and runs on its own.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-gallery.mjs",
    "previews": "node tools/screenshots.mjs",
    "gallery": "node tools/gallery-index.mjs",
    "all": "npm run build && npm run previews && npm run gallery"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@floating-ui/react": "0.26.28",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "class-variance-authority": "0.7.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.30.2",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.48.0",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.4.10"
  }
}
